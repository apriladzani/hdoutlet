# ==============================================================================
# HD Fried Chicken - Sales App Environment Template (.env.example)
# Salin file ini menjadi .env dan sesuaikan nilai variabelnya: cp .env.example .env
# ==============================================================================

# Port server aplikasi (Default: 3000)
PORT=3000

# Environment mode: development / production
NODE_ENV=development

# Base URL aplikasi
APP_URL=http://localhost:3000

# Gemini AI API Key (Diperlukan jika menggunakan fitur integrasi AI Gemini)
# Dapatkan API key di https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Pengaturan Vite / Development
# Set to 'true' jika ingin mematikan HMR (Hot Module Replacement)
DISABLE_HMR=false

# Frontend Public Variables (Prefix VITE_ agar dapat diakses di sisi client/browser)
VITE_APP_TITLE="HD Fried Chicken - Laporan Harian Outlet"
VITE_API_URL=http://localhost:3000/api
